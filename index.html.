    <script>
        // Shopping Cart Array State
        let cart = [];

        // Add item to Cart
        function addToCart(title, price) {
            const existingItem = cart.find(item => item.title === title);
            if (existingItem) {
                existingItem.quantity += 1;
            } else {
                cart.push({ title, price, quantity: 1 });
            }
            updateCartUI();
        }

        // Remove single item or decrease
        function changeQty(title, delta) {
            const item = cart.find(i => i.title === title);
            if (item) {
                item.quantity += delta;
                if (item.quantity <= 0) {
                    cart = cart.filter(i => i.title !== title);
                }
            }
            updateCartUI();
        }

        // Clear All Cart Items
        function clearCart() {
            cart = [];
            updateCartUI();
        }

        // Automatic Calculator & UI Updates
        function updateCartUI() {
            const cartList = document.getElementById('cart-items-list');
            const cartBadge = document.getElementById('cart-badge');
            const cartBadgeMobile = document.getElementById('cart-badge-mobile');
            const subtotalPrice = document.getElementById('subtotal-price');
            const totalPrice = document.getElementById('total-price');

            let totalCount = 0;
            let totalAmount = 0;

            if (cart.length === 0) {
                cartList.innerHTML = `<p class="text-slate-400 text-xs text-center py-8">السلة فارغة حالياً. قم باختيار الخدمات من الأعلى.</p>`;
            } else {
                cartList.innerHTML = cart.map(item => {
                    const itemTotal = item.price * item.quantity;
                    totalCount += item.quantity;
                    totalAmount += itemTotal;
                    return `
                        <div class="flex items-center justify-between p-3 bg-[#121110] border border-amber-900/30 rounded-xl text-xs">
                            <div class="flex-1 ltr:pr-2 rtl:pl-2">
                                <h4 class="font-bold text-slate-200">${item.title}</h4>
                                <span class="text-amber-400 font-semibold">${item.price} د.أ / للوحدة</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <button onclick="changeQty('${item.title}', -1)" class="w-6 h-6 rounded bg-amber-500/20 text-amber-300 flex items-center justify-center font-bold hover:bg-amber-500/40">-</button>
                                <span class="text-white font-bold">${item.quantity}</span>
                                <button onclick="changeQty('${item.title}', 1)" class="w-6 h-6 rounded bg-amber-500/20 text-amber-300 flex items-center justify-center font-bold hover:bg-amber-500/40">+</button>
